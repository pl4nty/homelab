+// Nodes the cloud node controller hasn't initialised yet have no provider ID, and nodes on other
+// providers have someone else's. Neither may stop the lookups finding the instance's own node.
+func TestInstanceNodeLookupsWithUnmappedNodes(t *testing.T) {
+	onPrem := &v1.Node{
+		ObjectMeta: metav1.ObjectMeta{Name: "on-prem", Labels: map[string]string{IPv4NodeIPFamilyLabel: "true"}},
+	}
+	otherCloud := &v1.Node{
+		ObjectMeta: metav1.ObjectMeta{Name: "other-cloud", Labels: map[string]string{IPv4NodeIPFamilyLabel: "true"}},
+		Spec:       v1.NodeSpec{ProviderID: "aws:///us-east-1a/i-0123456789"},
+	}
+	// named after instances["instance1"], whose display name is instance1
+	uninitialised := &v1.Node{
+		ObjectMeta: metav1.ObjectMeta{Name: "instance1", Labels: map[string]string{IPv6NodeIPFamilyLabel: "true"}},
+	}
+	initialised := &v1.Node{
+		ObjectMeta: metav1.ObjectMeta{
+			Name:        "instance1",
+			Labels:      map[string]string{IPv4NodeIPFamilyLabel: "true", IPv6NodeIPFamilyLabel: "true"},
+			Annotations: map[string]string{CompartmentIDAnnotation: "annotated"},
+		},
+		Spec: v1.NodeSpec{ProviderID: "oci://ocid1.instance1"},
+	}
+	// same name as the instance, but it's another instance's node
+	otherInstance := &v1.Node{
+		ObjectMeta: metav1.ObjectMeta{Name: "instance1", Labels: map[string]string{IPv6NodeIPFamilyLabel: "true"}},
+		Spec:       v1.NodeSpec{ProviderID: "oci://ocid1.other"},
+	}
+
+	testCases := []struct {
+		name   string
+		nodes  []*v1.Node
+		family []string
+	}{
+		{name: "node being initialised, found by name", nodes: []*v1.Node{onPrem, otherCloud, uninitialised}, family: []string{IPv6}},
+		{name: "initialised node after unmapped ones", nodes: []*v1.Node{onPrem, otherCloud, initialised}, family: []string{IPv4, IPv6}},
+		{name: "name matches but provider ID doesn't", nodes: []*v1.Node{onPrem, otherInstance}, family: []string{}},
+		{name: "no node for the instance", nodes: []*v1.Node{onPrem, otherCloud}, family: []string{}},
+	}
+	for _, tt := range testCases {
+		t.Run(tt.name, func(t *testing.T) {
+			cp := &CloudProvider{
+				NodeLister:    &mockNodeLister{nodes: tt.nodes},
+				client:        MockOCIClient{},
+				config:        &providercfg.Config{CompartmentID: "testCompartment"},
+				logger:        zap.S(),
+				instanceCache: &mockInstanceCache{},
+			}
+			family, err := cp.getNodeIpFamily(context.Background(), "ocid1.instance1")
+			if err != nil {
+				t.Fatalf("getNodeIpFamily: unexpected error %v", err)
+			}
+			if !reflect.DeepEqual(family, tt.family) {
+				t.Errorf("getNodeIpFamily => %v, want %v", family, tt.family)
+			}
+		})
+	}
+
+	t.Run("compartment without an annotated node", func(t *testing.T) {
+		cp := &CloudProvider{
+			NodeLister:    &mockNodeLister{nodes: []*v1.Node{onPrem, otherCloud}},
+			client:        MockOCIClient{},
+			config:        &providercfg.Config{CompartmentID: "testCompartment"},
+			logger:        zap.S(),
+			instanceCache: &mockInstanceCache{},
+		}
+		// not in the cache: the compute mock answers with compartment "default"
+		compartment, err := cp.getCompartmentIDByInstanceID(context.Background(), "ocid1.uncached")
+		if err != nil {
+			t.Fatalf("getCompartmentIDByInstanceID: unexpected error %v", err)
+		}
+		if compartment != "default" {
+			t.Errorf("getCompartmentIDByInstanceID => %q, want %q", compartment, "default")
+		}
+	})
+}
