diff --git a/server/database/submissions.ts b/server/database/submissions.ts
new file mode 100644
index 0000000..3acbbc8
--- /dev/null
+++ b/server/database/submissions.ts
@@ -0,0 +1,45 @@
+import db from './db'
+import { Challenge } from '../challenges/types'
+import { User } from './users'
+import { UserMember } from './members'
+
+// every evaluated flag attempt, correct or not. memberid and memberemail are null for whole-team sessions,
+// and memberemail is a copy so the record survives the member's deletion
+export interface Submission {
+  id: string;
+  userid: User['id'];
+  memberid: UserMember['id'] | null;
+  memberemail: UserMember['email'] | null;
+  challengeid: Challenge['id'];
+  flag: string;
+  result: string;
+  ip: string | null;
+  createdat: Date;
+}
+
+export const newSubmission = ({ id, userid, memberid, memberemail, challengeid, flag, result, ip, createdat }: Submission): Promise<Submission> => {
+  return db.query<Submission>(
+    'INSERT INTO submissions (id, userid, memberid, memberemail, challengeid, flag, result, ip, createdat) VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9) RETURNING *',
+    [id, userid, memberid, memberemail, challengeid, flag, result, ip, createdat]
+  )
+    .then(res => res.rows[0])
+}
+
+export interface SubmissionFilter {
+  userid?: string;
+  memberid?: string;
+  challengeid?: string;
+  limit: number;
+  offset: number;
+}
+
+export const getSubmissions = ({ userid, memberid, challengeid, limit, offset }: SubmissionFilter): Promise<Submission[]> => {
+  // null parameters disable their filter
+  return db.query<Submission>(
+    `SELECT * FROM submissions
+    WHERE ($1::text IS NULL OR userid = $1) AND ($2::text IS NULL OR memberid = $2) AND ($3::text IS NULL OR challengeid = $3)
+    ORDER BY createdat DESC LIMIT $4 OFFSET $5`,
+    [userid ?? null, memberid ?? null, challengeid ?? null, limit, offset]
+  )
+    .then(res => res.rows)
+}
