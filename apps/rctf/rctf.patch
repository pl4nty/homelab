+++ b/apps/api/src/util/browser-id.ts
@@ -0,0 +1,29 @@
+import { config } from '@rctf/config'
+import type { Context } from 'hono'
+import { getCookie, setCookie } from 'hono/cookie'
+
+// NOTE: an opaque random id per browser, so admins can tell apart the browsers that share a team login.
+//   It identifies a cookie jar, not a person: a private window, another browser or cleared cookies get a new id,
+//   and anyone can send any id, so treat it as a hint like the IP.
+export const BROWSER_ID_COOKIE = 'rctf_browser'
+const BROWSER_ID_PATTERN =
+  /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/
+// browsers cap cookie lifetimes at 400 days
+const BROWSER_ID_MAX_AGE = 400 * 24 * 60 * 60
+
+// returns the id the request's browser sent, or undefined for a client without one (a script, or a browser's
+// first request), which this response then issues one to
+export const getBrowserId = (c: Context): string | undefined => {
+  const existing = getCookie(c, BROWSER_ID_COOKIE)
+  if (existing && BROWSER_ID_PATTERN.test(existing)) {
+    return existing
+  }
+  setCookie(c, BROWSER_ID_COOKIE, crypto.randomUUID(), {
+    path: '/',
+    httpOnly: true,
+    sameSite: 'Lax',
+    secure: config.origin.startsWith('https:'),
+    maxAge: BROWSER_ID_MAX_AGE,
+  })
+  return undefined
+}
