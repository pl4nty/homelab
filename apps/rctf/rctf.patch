+import * as database from '../../../database'
+import * as auth from '../../../auth'
+import { responses } from '../../../responses'
+import config from '../../../config/server'
+
+// a member's personal login link, for CTFs without email. whoever holds the team token can log in as any member,
+// so this attributes work within a team that trusts its captain; emailed member logins don't have that limit
+export default {
+  method: 'GET',
+  path: '/users/me/members/:id/token',
+  requireAuth: true,
+  teamOnly: true,
+  schema: {
+    params: {
+      type: 'object',
+      properties: {
+        id: {
+          type: 'string'
+        }
+      },
+      required: ['id']
+    }
+  },
+  handler: async ({ req, user }) => {
+    if (!config.userMembers) {
+      return responses.badEndpoint
+    }
+
+    const member = await database.members.getMemberByIdAndUserId({ id: req.params.id, userid: user.id })
+    if (member === undefined) {
+      return responses.badUnknownUser
+    }
+
+    const memberToken = await auth.token.getToken(auth.token.tokenKinds.member, { u: user.id, m: member.id })
+    req.log.info({ memberId: member.id }, 'member login token issued')
+    return [responses.goodMemberToken, { memberToken }]
+  }
+}
