@@ -0,0 +1,42 @@
+import db from './db'
+import { User } from './users'
+import { UserMember } from './members'
+
+export type LoginMethod = 'teamToken' | 'memberToken' | 'memberEmail' | 'recover' | 'ctftime'
+
+// every issued auth token. memberid and memberemail are null for whole-team sessions
+export interface Login {
+  id: string;
+  userid: User['id'];
+  memberid: UserMember['id'] | null;
+  memberemail: UserMember['email'] | null;
+  method: LoginMethod;
+  ip: string | null;
+  useragent: string | null;
+  createdat: Date;
+}
+
+export const newLogin = ({ id, userid, memberid, memberemail, method, ip, useragent, createdat }: Login): Promise<Login> => {
+  return db.query<Login>(
+    'INSERT INTO logins (id, userid, memberid, memberemail, method, ip, useragent, createdat) VALUES ($1, $2, $3, $4, $5, $6, $7, $8) RETURNING *',
+    [id, userid, memberid, memberemail, method, ip, useragent, createdat]
+  )
+    .then(res => res.rows[0])
+}
+
+export interface LoginFilter {
+  userid?: string;
+  memberid?: string;
+  limit: number;
+  offset: number;
+}
+
+export const getLogins = ({ userid, memberid, limit, offset }: LoginFilter): Promise<Login[]> => {
+  return db.query<Login>(
+    `SELECT * FROM logins
+    WHERE ($1::text IS NULL OR userid = $1) AND ($2::text IS NULL OR memberid = $2)
+    ORDER BY createdat DESC LIMIT $3 OFFSET $4`,
+    [userid ?? null, memberid ?? null, limit, offset]
+  )
+    .then(res => res.rows)
+}
