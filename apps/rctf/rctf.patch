+import { v4 as uuidv4 } from 'uuid'
+import { FastifyRequest } from 'fastify'
+import { getToken, tokenKinds, Token } from './token'
+import * as database from '../database'
+import { User } from '../database/users'
+import { UserMember } from '../database/members'
+import { LoginMethod } from '../database/logins'
+
+// issues an auth token for the team, or for one of its members, and records the login
+export const startSession = async ({ req, userId, member, method }: {
+  req: FastifyRequest
+  userId: User['id']
+  member: UserMember | null
+  method: LoginMethod
+}): Promise<Token> => {
+  const authToken = await getToken(tokenKinds.auth, member === null ? userId : { u: userId, m: member.id })
+  await database.logins.newLogin({
+    id: uuidv4(),
+    userid: userId,
+    memberid: member?.id ?? null,
+    memberemail: member?.email ?? null,
+    method,
+    ip: req.ip,
+    useragent: req.headers['user-agent'] ?? null,
+    createdat: new Date()
+  })
+  req.log.info({ userId, memberId: member?.id, method }, 'session started')
+  return authToken
+}
