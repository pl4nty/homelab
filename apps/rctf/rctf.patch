diff --git a/apps/api/src/middlewares/app-env.ts b/apps/api/src/middlewares/app-env.ts
index 46cc4dd1..5993f9ea 100644
--- a/apps/api/src/middlewares/app-env.ts
+++ b/apps/api/src/middlewares/app-env.ts
@@ -1,6 +1,7 @@
 import { config } from '@rctf/config'
 import { createDatabase } from '@rctf/db'
 import type { MiddlewareHandler } from 'hono'
+import { getCookie, setCookie } from 'hono/cookie'
 import type { AppEnv } from '../lib/app-env'
 import { getIp } from '../util/ip'
 import { createRedis } from '../util/redis'
@@ -15,7 +16,18 @@ export const appEnvMiddleware: MiddlewareHandler<AppEnv> = async (c, next) => {
 
   const ip = getIp(c)
   c.set('ip', ip)
-  c.set('logger', c.var.logger.assign({ ip }))
+  // a random id per browser, so submissions from a shared team login can be told apart.
+  // undefined for a client that sent none, like a script, which this response issues one to
+  const browserId = getCookie(c, 'rctf_browser')
+  if (!browserId) {
+    setCookie(c, 'rctf_browser', crypto.randomUUID(), {
+      httpOnly: true,
+      secure: config.origin.startsWith('https:'),
+      maxAge: 400 * 24 * 60 * 60,
+    })
+  }
+  c.set('browserId', browserId)
+  c.set('logger', c.var.logger.assign({ ip, browserId }))
 
   await next()
 }
