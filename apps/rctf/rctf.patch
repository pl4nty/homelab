+import * as database from '../../../database'
+import { responses } from '../../../responses'
+import perms from '../../../util/perms'
+
+// submissions hold flags, so they need the permission that already exposes flags
+export default {
+  method: 'GET',
+  path: '/admin/submissions',
+  requireAuth: true,
+  perms: perms.challsRead,
+  schema: {
+    querystring: {
+      type: 'object',
+      properties: {
+        userid: { type: 'string' },
+        memberid: { type: 'string' },
+        challengeid: { type: 'string' },
+        limit: { type: 'integer', minimum: 1, maximum: 1000, default: 100 },
+        offset: { type: 'integer', minimum: 0, default: 0 }
+      }
+    }
+  },
+  handler: async ({ req }) => {
+    const submissions = await database.submissions.getSubmissions(req.query)
+    return [responses.goodSubmissions, submissions]
+  }
+}
