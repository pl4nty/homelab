@@ -0,0 +1,118 @@
+import { SubmissionKind, SubmissionResult } from '@rctf/types'
+import {
+  applyDeepLinkFilters,
+  browserIdOf,
+  browserLabel,
+  buildSubmissionsBody,
+  createDeepLinkLatch,
+  createSubmissionFilters,
+  detailEntries,
+  hasSubmissionFilters,
+  initialSubmissionSort,
+  type Submission,
+} from '$routes/admin/submissions/submissions-model'
+import { describe, expect, test } from 'bun:test'
+
+const browserId = '0b6f2c1e-7d4a-4c1b-9e3f-5a6b7c8d9e0f'
+
+function submissionWith(overrides: Partial<Submission>): Submission {
+  return {
+    id: 'sub-1',
+    kind: SubmissionKind.FLAG,
+    challengeId: 'baby-rev',
+    challengeName: 'baby-rev',
+    challengeCategory: 'rev',
+    userId: 'team-1',
+    userName: 'otter-sec',
+    userDivision: 'open',
+    userAvatarUrl: null,
+    userCountryCode: null,
+    userStatusText: null,
+    userBanned: false,
+    ip: '203.0.113.7',
+    result: SubmissionResult.INCORRECT,
+    cheatedFromId: null,
+    cheatedFromName: null,
+    details: {},
+    relatedId: null,
+    createdAt: '2024-03-09T00:00:00.000Z',
+    ...overrides,
+  }
+}
+
+describe('browser filter', () => {
+  test('shows the browser and user agent of a flag submission', () => {
+    const entries = detailEntries(
+      submissionWith({
+        details: { submittedFlag: 'flag{x}', browserId, userAgent: 'curl/8' },
+      })
+    )
+
+    expect(entries).toEqual([
+      { label: 'flag', value: 'flag{x}' },
+      {
+        label: 'browser',
+        value: browserId,
+        href: `/admin/submissions?browser=${browserId}`,
+      },
+      { label: 'agent', value: 'curl/8', wide: true },
+    ])
+  })
+
+  test('shows the browser of an admin bot submission', () => {
+    const entries = detailEntries(
+      submissionWith({
+        kind: SubmissionKind.ADMIN_BOT,
+        result: SubmissionResult.QUEUED,
+        details: { browserId },
+      })
+    )
+
+    expect(entries.map(entry => entry.label)).toEqual(['browser'])
+  })
+
+  test('omits browser pills for submissions without them', () => {
+    expect(
+      detailEntries(submissionWith({ details: { submittedFlag: 'x' } }))
+    ).toEqual([{ label: 'flag', value: 'x' }])
+    expect(browserIdOf(submissionWith({}))).toBeNull()
+  })
+
+  test('labels browsers by their prefix', () => {
+    expect(browserLabel(browserId)).toBe('0b6f2c1e')
+    expect(browserLabel('')).toBe('No browser cookie')
+  })
+
+  test('sends the browser filter in the request body', () => {
+    const filters = createSubmissionFilters()
+    filters.browser.mode = 'exclude'
+    filters.browser.selected = [browserId, '']
+
+    expect(hasSubmissionFilters(filters)).toBe(true)
+    expect(
+      buildSubmissionsBody(filters, initialSubmissionSort()).browser
+    ).toEqual({ exclude: [browserId, ''] })
+  })
+
+  test('applies a browser deep link once', () => {
+    const filters = createSubmissionFilters()
+    const none = { id: null, option: null }
+
+    let latch = applyDeepLinkFilters(filters, createDeepLinkLatch(), {
+      team: none,
+      challenge: none,
+      browser: browserId,
+    })
+    expect(latch.browserId).toBe(browserId)
+    expect(filters.browser).toEqual({ mode: 'include', selected: [browserId] })
+
+    // clearing the chip keeps it cleared while the URL still has the link
+    filters.browser.selected = []
+    latch = applyDeepLinkFilters(filters, latch, {
+      team: none,
+      challenge: none,
+      browser: browserId,
+    })
+    expect(filters.browser.selected).toEqual([])
+  })
+})
