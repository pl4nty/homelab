@@ -0,0 +1,210 @@
+import { config } from '@rctf/config'
+import { createDatabase, submissions } from '@rctf/db'
+import {
+  BadFlag,
+  BadAlreadySolvedChallenge,
+  GoodAdminSubmissions,
+  GoodFlag,
+  Permissions,
+} from '@rctf/types'
+import { beforeAll, beforeEach, describe, expect, test } from 'bun:test'
+import { eq } from 'drizzle-orm'
+import type { Hono } from 'hono'
+import { getApp, request } from '../../app'
+import {
+  clearDatabase,
+  expectResponse,
+  generateAuthToken,
+  generateChallenge,
+  generateRealTestUser,
+} from '../../util'
+
+let app: Hono<any>
+const getDb = () => createDatabase(config.database.sql).db
+
+beforeAll(async () => {
+  app = await getApp()
+})
+
+beforeEach(async () => {
+  await clearDatabase()
+})
+
+const BROWSER_COOKIE = /rctf_browser=([0-9a-f-]{36})/
+
+const issuedBrowserId = (res: Response): string | undefined =>
+  BROWSER_COOKIE.exec(res.headers.get('set-cookie') ?? '')?.[1]
+
+const submit = (
+  token: string,
+  challengeId: string,
+  flag: string,
+  { browserId, userAgent }: { browserId?: string; userAgent?: string } = {}
+) =>
+  request(app, `/api/v1/challs/${challengeId}/submit`, {
+    method: 'POST',
+    headers: {
+      'Content-Type': 'application/json',
+      Authorization: `Bearer ${token}`,
+      ...(browserId ? { Cookie: `rctf_browser=${browserId}` } : {}),
+      ...(userAgent ? { 'User-Agent': userAgent } : {}),
+    },
+    body: JSON.stringify({ flag }),
+  })
+
+const detailsFor = async (challengeId: string) => {
+  const rows = await getDb()
+    .select({ result: submissions.result, details: submissions.details })
+    .from(submissions)
+    .where(eq(submissions.challengeId, challengeId))
+  return rows
+}
+
+describe('browser id', () => {
+  test('issues an HttpOnly cookie to a client without one', async () => {
+    const res = await request(app, '/api/v1/challs', { method: 'GET' })
+    const cookie = res.headers.get('set-cookie') ?? ''
+
+    expect(issuedBrowserId(res)).toBeDefined()
+    expect(cookie).toContain('HttpOnly')
+    expect(cookie).toContain('SameSite=Lax')
+    expect(cookie).toContain('Path=/')
+    expect(cookie).toContain('Max-Age=34560000')
+  })
+
+  test('keeps a valid cookie and replaces an invalid one', async () => {
+    const browserId = crypto.randomUUID()
+    const kept = await request(app, '/api/v1/challs', {
+      method: 'GET',
+      headers: { Cookie: `rctf_browser=${browserId}` },
+    })
+    expect(kept.headers.get('set-cookie')).toBeNull()
+
+    const replaced = await request(app, '/api/v1/challs', {
+      method: 'GET',
+      headers: { Cookie: 'rctf_browser=not-a-uuid' },
+    })
+    expect(issuedBrowserId(replaced)).toBeDefined()
+  })
+
+  test('records the browser and user agent on each flag result', async () => {
+    const team = await generateRealTestUser()
+    const token = await generateAuthToken(team.user.id)
+    const { challenge } = await generateChallenge()
+    const alice = crypto.randomUUID()
+    const bob = crypto.randomUUID()
+
+    await expectResponse(
+      await submit(token, challenge.id, 'wrong', {
+        browserId: alice,
+        userAgent: 'alice-agent',
+      }),
+      BadFlag
+    )
+    await expectResponse(
+      await submit(token, challenge.id, challenge.flag, {
+        browserId: bob,
+        userAgent: 'bob-agent',
+      }),
+      GoodFlag
+    )
+    await expectResponse(
+      await submit(token, challenge.id, challenge.flag, {
+        browserId: alice,
+        userAgent: 'alice-agent',
+      }),
+      BadAlreadySolvedChallenge
+    )
+
+    const rows = await detailsFor(challenge.id)
+    const byResult = Object.fromEntries(
+      rows.map(row => [row.result, row.details])
+    )
+    expect(byResult.incorrect).toMatchObject({
+      browserId: alice,
+      userAgent: 'alice-agent',
+      submittedFlag: 'wrong',
+    })
+    expect(byResult.correct).toMatchObject({
+      browserId: bob,
+      userAgent: 'bob-agent',
+      submittedFlag: challenge.flag,
+    })
+    expect(byResult.already_solved).toMatchObject({
+      browserId: alice,
+      userAgent: 'alice-agent',
+    })
+  })
+
+  test('records no browser for a client without the cookie', async () => {
+    const team = await generateRealTestUser()
+    const token = await generateAuthToken(team.user.id)
+    const { challenge } = await generateChallenge()
+
+    const res = await submit(token, challenge.id, 'wrong')
+    await expectResponse(res, BadFlag)
+    expect(issuedBrowserId(res)).toBeDefined()
+
+    const [row] = await detailsFor(challenge.id)
+    expect(row!.details).not.toHaveProperty('browserId')
+  })
+
+  test('truncates long user agents', async () => {
+    const team = await generateRealTestUser()
+    const token = await generateAuthToken(team.user.id)
+    const { challenge } = await generateChallenge()
+
+    await submit(token, challenge.id, 'wrong', {
+      browserId: crypto.randomUUID(),
+      userAgent: 'a'.repeat(2000),
+    })
+
+    const [row] = await detailsFor(challenge.id)
+    expect((row!.details.userAgent as string).length).toBe(512)
+  })
+
+  test('admins filter submissions by browser', async () => {
+    const admin = await generateRealTestUser(
+      Permissions.usersWrite | Permissions.challsRead
+    )
+    const adminToken = await generateAuthToken(admin.user.id)
+    const team = await generateRealTestUser()
+    const token = await generateAuthToken(team.user.id)
+    const alice = crypto.randomUUID()
+    const bob = crypto.randomUUID()
+
+    // separate challenges, so the per-challenge rate limit doesn't apply
+    for (const browserId of [alice, alice, bob, undefined]) {
+      const { challenge } = await generateChallenge()
+      await expectResponse(
+        await submit(token, challenge.id, 'wrong', { browserId }),
+        BadFlag
+      )
+    }
+
+    const filter = async (browser: Record<string, string[]>) => {
+      const res = await request(
+        app,
+        '/api/v2/admin/submissions?limit=100&offset=0',
+        {
+          method: 'POST',
+          headers: {
+            'Content-Type': 'application/json',
+            Authorization: `Bearer ${adminToken}`,
+          },
+          body: JSON.stringify({ browser }),
+        }
+      )
+      const body = await expectResponse(res, GoodAdminSubmissions)
+      return body.data.submissions.map(
+        (submission: any) => submission.details.browserId ?? ''
+      )
+    }
+
+    expect(await filter({ include: [alice] })).toEqual([alice, alice])
+    expect((await filter({ exclude: [alice] })).sort()).toEqual(
+      [bob, ''].sort()
+    )
+    expect(await filter({ include: [''] })).toEqual([''])
+  })
+})
