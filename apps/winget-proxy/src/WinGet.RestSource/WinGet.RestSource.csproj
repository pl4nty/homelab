<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../WinGet.RestSource.Shared/WinGet.RestSource.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Features/catalog.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
