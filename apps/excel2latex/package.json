{
  "name": "excel2latex",
  "version": "1.0.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/pl4nty/homelab.git",
    "directory": "apps/excel2latex"
  },
  "license": "MIT",
  "config": {
    "app_to_debug": "excel",
    "app_type_to_debug": "desktop",
    "dev_server_port": 3000
  },
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "dev-server": "webpack serve --mode development",
    "start": "office-addin-debugging start manifest.xml",
    "start:desktop": "office-addin-debugging start manifest.xml desktop",
    "start:web": "office-addin-debugging start manifest.xml web",
    "stop": "office-addin-debugging stop manifest.xml",
    "validate": "office-addin-manifest validate manifest.xml",
    "watch": "webpack --mode development --watch"
  },
  "dependencies": {
    "core-js": "3.51.0",
    "regenerator-runtime": "0.14.1"
  },
  "devDependencies": {
    "@babel/core": "8.0.9",
    "@babel/preset-typescript": "8.0.7",
    "@types/office-js": "1.0.614",
    "@types/office-runtime": "1.0.40",
    "acorn": "8.19.0",
    "babel-loader": "10.1.1",
    "copy-webpack-plugin": "14.0.0",
    "file-loader": "6.2.0",
    "html-loader": "5.1.0",
    "html-webpack-plugin": "5.6.8",
    "office-addin-cli": "3.0.1",
    "office-addin-debugging": "7.0.1",
    "office-addin-dev-certs": "3.0.1",
    "office-addin-manifest": "3.0.1",
    "os-browserify": "0.3.0",
    "process": "0.11.10",
    "source-map-loader": "5.0.0",
    "ts-loader": "9.6.2",
    "typescript": "5.9.3",
    "webpack": "5.112.2",
    "webpack-cli": "7.2.3",
    "webpack-dev-server": "5.2.7",
    "@types/mathjax": "0.0.40"
  },
  "browserslist": [
    "ie 11"
  ]
}
