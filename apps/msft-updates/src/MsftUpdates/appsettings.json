{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Sync": {
    "Enabled": true,
    "Interval": "06:00:00",
    "Parallelism": 32
  },
  "Catalog": {
    "DataPath": "/data/catalog",
    "MemoryLimit": "1GB",
    "Threads": 2
  },
  "Query": {
    "MaxRows": 100000,
    "Timeout": "00:02:00",
    "MaxConcurrency": 2
  }
}
