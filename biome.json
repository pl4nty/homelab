{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "apps/excel2latex/**",
      "apps/tenant-lookup/**",
      "apps/vscode-oci-layers/**",
      "!**/package-lock.json",
      "!apps/vscode-oci-layers/src/types/vscode.proposed.*.d.ts"
    ]
  },
  "formatter": { "indentStyle": "space", "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "overrides": [
    {
      "includes": ["apps/tenant-lookup/index.html"],
      "linter": { "enabled": false }
    }
  ]
}
