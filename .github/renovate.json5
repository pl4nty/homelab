{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>pl4nty/.github',
    'docker:enableMajor',
    ':disableRateLimiting',
    ':dependencyDashboard',
    ':semanticCommits',
    ':enablePreCommit',
    ':automergeDigest',
    ':automergeBranch',
    'github>pl4nty/homelab//.github/renovate/autoMerge.json5',
    'github>pl4nty/homelab//.github/renovate/commitMessage.json5',
    'github>pl4nty/homelab//.github/renovate/labels.json5',
    'github>pl4nty/homelab//.github/renovate/semanticCommits.json5',
    'helpers:pinGitHubActionDigests',
  ],
  ignoreTests: true,
  ignorePaths: [
    '**/node_modules/**',
    'archive/**',
  ],
  dependencyDashboard: {
    osvVulnerabilitySummary: 'all',
  },
  lockFileMaintenance: {
    enabled: true,
    automerge: true,
  },
  suppressNotifications: [
    'prIgnoreNotification',
  ],
  flux: {
    managerFilePatterns: [
      '/kubernetes/[^.]+\\.ya?ml$/',
    ],
  },
  'helm-values': {
    managerFilePatterns: [
      '/kubernetes/[^.]+\\.ya?ml$/',
    ],
  },
  kubernetes: {
    managerFilePatterns: [
      '/kubernetes/[^.]+\\.ya?ml$/',
    ],
  },
  kustomize: {
    managerFilePatterns: [
      '/kubernetes/[^.]+kustomization\\.ya?ml$/',
    ],
  },
  customManagers: [
    {
      customType: 'regex',
      description: 'Process CRD dependencies',
      managerFilePatterns: [
        '/kubernetes/[^.]+\\.ya?ml$/',
      ],
      matchStrings: [
        'registryUrl=(?<registryUrl>\\S+) chart=(?<depName>\\S+)\n.*?(?<currentValue>[^-\\s]*)\n',
      ],
      datasourceTemplate: '{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}',
      versioningTemplate: '{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}',
    },
    {
      customType: 'regex',
      description: 'Process custom dependencies',
      managerFilePatterns: [
        '/kubernetes/[^.]+\\.ya?ml$/',
      ],
      matchStrings: [
        'datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\n.*?"(?<currentValue>.*)"\n',
      ],
      datasourceTemplate: '{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}',
      versioningTemplate: '{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}',
    },
    {
      customType: 'regex',
      description: 'Process app source git contexts',
      managerFilePatterns: [
        '/apps/[^/]+/docker-bake\\.hcl$/',
      ],
      matchStrings: [
        '# renovate: branch=(?<currentValue>\\S+)\n\\s*\\S+\\s*=\\s*"(?<depName>https://github\\.com/[^"#?]+?)(\\.git)?(\\?[^"#]*)?#(?<currentDigest>[0-9a-f]{40})"',
      ],
      datasourceTemplate: 'git-refs',
    },
    {
      customType: 'regex',
      description: 'Process raw GitHub URLs',
      managerFilePatterns: [
        '/kubernetes/[^.]+\\.ya?ml$/',
      ],
      matchStrings: [
        'https:\\/\\/raw.githubusercontent.com\\/(?<depName>[\\w\\d\\-_]+\\/[\\w\\d\\-_]+)\\/(?<currentValue>[\\w\\d\\.\\-_]+)\\/.*',
      ],
      datasourceTemplate: 'github-releases',
      versioningTemplate: 'semver',
    },
    {
      customType: 'regex',
      description: 'Talos and Kubernetes versions in topf.yaml',
      managerFilePatterns: [
        '/^talos/topf\\.yaml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\n\\w+: (?<currentValue>\\S+)\n',
      ],
      extractVersionTemplate: '^v(?<version>.+)$',
    },
    {
      customType: 'regex',
      description: 'riscv64-capable kube-proxy in the Talos config',
      managerFilePatterns: [
        '/^talos/control-plane/control-plane\\.yaml$/',
      ],
      matchStrings: [
        'image: (?<depName>quay\\.io/k0sproject/kube-proxy):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})',
      ],
      datasourceTemplate: 'docker',
    },
  ],
  packageRules: [
    {
      matchFileNames: [
        'apps/**',
      ],
      rangeStrategy: 'pin',
    },
    {
      description: 'The base image sets the Python version, and engines are compatibility ranges, so never pin them',
      matchFileNames: [
        'apps/**',
      ],
      matchDepTypes: [
        'requires-python',
        'engines',
      ],
      enabled: false,
    },
    {
      description: 'A bare NuGet version already resolves to that exact version, so pinning only rewrites it as [x] and bumps it',
      matchFileNames: [
        'apps/**',
      ],
      matchManagers: [
        'nuget',
      ],
      rangeStrategy: 'auto',
    },
    {
      description: 'Renovate pins cabal deps without ==, which cabal rejects, and base is tied to the GHC in the base image',
      matchFileNames: [
        'apps/**',
      ],
      matchManagers: [
        'haskell-cabal',
      ],
      rangeStrategy: 'auto',
    },
    {
      matchFileNames: [
        'apps/**',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      matchCurrentVersion: '!/^0/',
      automerge: true,
    },
    {
      matchDatasources: [
        'git-refs',
      ],
      matchPackageNames: [
        'https://github.com/pl4nty/**',
        'https://github.com/microsoft/MHA',
        'https://github.com/microsoft/garnet',
        'https://github.com/open-telemetry/opentelemetry-cpp-contrib',
      ],
      automerge: true,
    },
    {
      matchUpdateTypes: [
        'patch',
      ],
      matchPackageNames: [
        'opentelemetry-operator',
        'ghcr.io/home-assistant/home-assistant',
        'ghcr.io/stirling-tools/s-pdf',
      ],
      automerge: true,
    },
    {
      matchUpdateTypes: [
        'patch',
        'minor',
      ],
      matchPackageNames: [
        'k8s-monitoring',
        'ghcr.io/intuitem/ciso-assistant-community/backend',
        'ghcr.io/intuitem/ciso-assistant-community/frontend',
      ],
      automerge: true,
    },
    {
      description: 'Longhorn only supports upgrading one minor version at a time',
      matchPackageNames: [
        'longhorn',
      ],
      groupName: 'longhorn',
      separateMultipleMinor: true,
    },
    {
      description: 'Talos and Kubernetes upgrade one minor at a time, and are applied to the cluster by hand',
      matchFileNames: [
        'talos/**',
      ],
      separateMultipleMinor: true,
      automerge: false,
    },
    {
      matchPackageNames: [
        'siderolabs/talos',
      ],
      groupName: 'talos',
    },
    {
      description: 'kube-proxy must not be newer than the apiserver',
      matchPackageNames: [
        'kubernetes/kubernetes',
        'quay.io/k0sproject/kube-proxy',
      ],
      groupName: 'kubernetes',
    },
    {
      description: 'One PR per app, named after it, so each gets its own preview',
      matchFileNames: [
        'apps/**',
      ],
      additionalBranchPrefix: "{{lookup (split packageFileDir '/') 1}}-",
      semanticCommitScope: "{{lookup (split packageFileDir '/') 1}}",
    },
    {
      matchFileNames: [
        'apps/**',
      ],
      matchUpdateTypes: [
        'major',
      ],
      commitMessagePrefix: "feat({{lookup (split packageFileDir '/') 1}})!: ",
    },
    {
      description: 'App CI and previews only run on PRs, so automerge app updates through a PR once checks pass',
      matchFileNames: [
        'apps/**',
      ],
      automergeType: 'pr',
      platformAutomerge: false,
      ignoreTests: false,
    },
  ],
}
